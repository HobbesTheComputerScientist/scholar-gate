# Copy to .env.local and fill in values. Restart `npm run dev` after changes.
# Never prefix secrets with NEXT_PUBLIC_ (those are sent to the browser).

# --- Database + auth (optional) ---
# Both set: Supabase auth + Postgres. Both empty: local accounts + in-memory store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Coach AI (set at least one; otherwise a built-in heuristic coach replies) ---
# Groq: fast primary provider (coach, comprehension check, summaries).
GROQ_API_KEY=
# Optional comma-separated model override. Default: openai/gpt-oss-120b, qwen/qwen3.8-27b
GROQ_MODEL=
# Gemini: fallback provider (or primary when GROQ_API_KEY is empty).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite

# --- Paper search (optional) ---
# OpenAlex key, sent as `api_key`. Search works without it (lower quota).
OPENALEX_API_KEY=

# --- Local accounts (only used when Supabase is not configured) ---
# HMAC secret for the local session cookie. Change it outside local dev.
LOCAL_AUTH_SECRET=change-me-in-dev
